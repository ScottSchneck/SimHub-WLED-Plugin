<UserControl x:Class="WledSimHubPlugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WledSimHubPlugin"
             Background="#121212" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:IndexConverter x:Key="IndexConverter"/>
        <local:BoolToOpacityConverter x:Key="BoolToOpacity"/>
        <local:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="InputBackground" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="AccentColor" Color="#1DD383"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2BEA98"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0A0"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#CF6679"/>

        <!-- MD icon paths (24x24 viewbox) -->
        <Geometry x:Key="CopyIcon">M16,1H4C2.9,1,2,1.9,2,3v14h2V3h12V1z M19,5H8C6.9,5,6,5.9,6,7v14c0,1.1,0.9,2,2,2h11c1.1,0,2-0.9,2-2V7C21,5.9,20.1,5,19,5z M19,21H8V7h11V21z</Geometry>
        <Geometry x:Key="SendIcon">M2,4v7l10,2L2,15v5l20-8L2,4z</Geometry>
        <Geometry x:Key="DeleteIcon">M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z</Geometry>
        <Geometry x:Key="DeviceIcon">M9,21c0,0.5,0.4,1,1,1h4c0.6,0,1-0.4,1-1v-1H9V21z M12,2C8.1,2,5,5.1,5,9c0,2.6,1.3,4.8,3.3,6.2V17c0,0.6,0.4,1,1,1h5c0.6,0,1-0.4,1-1v-1.8C17.7,13.8,19,11.6,19,9C19,5.1,15.9,2,12,2z</Geometry>

        <!-- TextBox: bottom-border underline, accent on focus -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Filled primary button with press-scale feedback -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PS"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined secondary button -->
        <Style x:Key="OutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PS"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1DD383"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text tertiary button -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="4" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PS"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1DD383"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 32x32 circular icon button with press-scale -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="PS"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.08"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="PS" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MaterialSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track" Width="34" Height="14" CornerRadius="7" Background="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#BDBDBD" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#331DD383"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource AccentColor}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChevronToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="24" Height="24" CornerRadius="12" x:Name="bg">
                            <Path x:Name="Arrow" Data="M 7.41,8.59 L 12,13.17 L 16.59,8.59 L 18,10 L 12,16 L 6,10 Z" Fill="{StaticResource TextSecondary}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="Data" Value="M 8.59,16.59 L 13.17,12 L 8.59,7.41 L 10,6 L 16,12 L 10,18 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elevated card: no border, drop shadow for depth -->
        <Style x:Key="MaterialCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.35" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: GLOBAL PROFILE MANAGER -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.35" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <TextBlock Text="🎮 Global Profile:" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedValuePath="ProfileId" SelectedValue="{Binding SelectedProfileId}" DisplayMemberPath="ProfileName" Width="250" BorderThickness="0" Padding="8"/>
                </StackPanel>

                <!-- Button hierarchy: text < outlined < filled -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TextButton}" Margin="0,0,4,0" Content="Profile Manager" Click="ProfilesManager_Click"/>
                    <Button Style="{StaticResource OutlinedButton}" Margin="0,0,4,0" Content="Edit Profile" Click="EditProfile_Click"/>
                    <Button Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Content="Clone Profile" Click="CloneProfile_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="New Profile" Click="NewProfile_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: MASTER-DETAIL SPLIT WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DEVICE LIST -->
            <Border Grid.Column="0" Style="{StaticResource MaterialCard}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="WLED Devices" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Transparent" BorderThickness="0" Foreground="#F3F3F3">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="#2A2A2A" CornerRadius="4">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#331DD383"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ConnectionMethod}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Add New Device" Click="AddDevice_Click" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <!-- Empty state: shown when no device is selected -->
            <Border Grid.Column="1" Visibility="{Binding HasSelectedDevice, Converter={StaticResource InvertBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource DeviceIcon}" Fill="#333333"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="No device selected" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Select a device from the list, or add a new one to get started." Foreground="#555555" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="280"/>
                </StackPanel>
            </Border>

            <!-- RIGHT COLUMN: DEVICE WORKSPACE -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedDevice, Converter={StaticResource BoolToVis}}">
                <StackPanel>

                    <!-- Hardware Settings Card -->
                    <Border Style="{StaticResource MaterialCard}">
                        <Grid DataContext="{Binding SelectedDevice}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Name" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Type" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox SelectedIndex="{Binding ConnectionMethodInt}" Width="110">
                                    <ComboBoxItem Content="Network"/>
                                    <ComboBoxItem Content="Serial"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsNetwork, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="IP Address" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding WledIp}" Width="120" Margin="0,0,12,0"/>
                                <TextBlock Text="Port" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding UdpPort}" Width="55" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Port" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding DataContext.AvailableComPorts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding ComPort}" Width="140" Margin="0,0,12,0" DropDownOpened="ComPort_DropDownOpened"/>
                                <TextBlock Text="Baud" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding BaudRate}" Width="70" TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Pixels" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding TotalLedCount}" Width="50" TextAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" Width="100" Content="Test" PreviewMouseDown="TestButton_Down" PreviewMouseUp="TestButton_Up" Margin="0,0,8,0"/>
                            <Button Grid.Column="6" Style="{StaticResource FlatButton}" Foreground="{StaticResource ErrorColor}" Content="Delete Device" Click="DeleteDevice_Click"/>
                        </Grid>
                    </Border>

                    <!-- Rule Builder Card -->
                    <Border Style="{StaticResource MaterialCard}">
                        <StackPanel>
                            <TextBlock Text="Telemetry Properties" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Text="Search properties..." Foreground="{StaticResource TextSecondary}"/>
                            <ListBox x:Name="PropertyListBox" Height="130" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Margin="0,8,0,16" SelectionChanged="PropertyListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#331DD383"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Formula" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource FlatButton}" Content="➔ Insert Selected" HorizontalAlignment="Right" Click="InsertProperty_Click" Padding="8,4" FontSize="12"/>
                            </Grid>
                            <TextBox x:Name="ConditionBox" TextChanged="ConditionBox_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="70" FontFamily="Consolas" FontSize="14" PreviewKeyDown="FormulaBox_PreviewKeyDown" LostFocus="FormulaBox_LostFocus"/>

                            <Border Background="#151515" CornerRadius="4" Margin="0,8,0,16" Padding="8,6">
                                <TextBlock x:Name="SyntaxStatusText" Text="⚠️ Type a formula using [Brackets] for properties." Foreground="#FFB74D" FontSize="12" TextAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Rule Name" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewRuleNameBox" Grid.Column="0" Text="My Custom Rule" Margin="0,0,12,0"/>
                                <Button x:Name="AddRuleBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Add Rule To Selected Device" Click="AddRule_Click" IsEnabled="False" Padding="16,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Device Specific Rule List -->
                    <TextBlock Text="Rules are evaluated top to bottom — first match wins. Drag ⋮⋮ to reorder." Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                    <ListBox ItemsSource="{Binding CurrentDeviceRules}" Background="Transparent" BorderThickness="0" AllowDrop="True" Drop="RulesList_Drop" DragOver="RulesList_DragOver" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="PreviewMouseMove" Handler="RulesList_MouseMove"/>
                                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RulesList_PreviewMouseLeftButtonDown"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0" Margin="0,0,0,12">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource MaterialCard}">
                                            <Style.Triggers>
                                                <!-- Tonal surface when rule is firing: border + background tint -->
                                                <DataTrigger Binding="{Binding IsCurrentlyFiring}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1DD383"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Setter Property="Background" Value="#141DD383"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Rule header -->
                                        <Grid Margin="16,12" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="30"/>
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}" Style="{StaticResource ChevronToggle}"/>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Background="#2A2A2A" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold">
                                                            <TextBlock.Text>
                                                                <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}" Converter="{StaticResource IndexConverter}"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBox Text="{Binding RuleName}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" FontWeight="SemiBold" FontSize="16" Padding="0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Formula}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Icon action buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <Button Style="{StaticResource IconButton}" ToolTip="Duplicate rule" Click="DuplicateRule_Click" Margin="0,0,2,0">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource CopyIcon}" Fill="#A0A0A0"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Clone to another device" Click="CloneRuleToDevice_Click" Margin="0,0,2,0">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource SendIcon}" Fill="#A0A0A0"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" ToolTip="Remove rule" Click="DeleteRule_Click">
                                                    <Viewbox Width="15" Height="15">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Data="{StaticResource DeleteIcon}" Fill="#CF6679"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Inactive"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Text" Value="Active"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ToggleButton IsChecked="{Binding IsActive}" Style="{StaticResource MaterialSwitch}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="4" Text="⋮⋮" Cursor="SizeNS" Foreground="#555" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Animated expand/collapse detail panel -->
                                        <Border x:Name="DetailPanel" Background="#151515" CornerRadius="0,0,8,8" ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="MaxHeight" Value="2000"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.2">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="2000" Duration="0:0:0.25">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Margin="24">
                                                <TextBlock Text="Trigger Logic" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                                <TextBox Text="{Binding Formula}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,4" TextChanged="FormulaBox_TextChanged" PreviewKeyDown="FormulaBox_PreviewKeyDown" LostFocus="FormulaBox_LostFocus"/>
                                                <TextBlock Text="{Binding FormulaSyntaxStatus}" Foreground="{Binding FormulaSyntaxStatusColor}" FontSize="11" Margin="0,0,0,20"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                                        <TextBlock Text="Target Device Mode" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                                        <Grid Margin="0,0,0,12">
                                                            <TextBlock Text="Trigger WLED Preset" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <ToggleButton IsChecked="{Binding UsePreset}" Style="{StaticResource MaterialSwitch}" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Grid Visibility="{Binding UsePreset, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="WLED Preset ID" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding PresetId}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" Opacity="{Binding UsePreset, Converter={StaticResource BoolToOpacity}, ConverterParameter=Invert}">
                                                        <TextBlock Text="Pixel Mapping" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                                        <!-- Multi-segment LED range + per-segment colour editor -->
                                                        <StackPanel Margin="0,0,0,12">
                                                            <Grid Margin="0,0,0,6">
                                                                <TextBlock Text="LED Segments" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <Button HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                                                                        Content="＋ Add" Padding="6,2" FontSize="11"
                                                                        Click="AddSegment_Click"/>
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Segments}" Tag="{Binding}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Start / Stop -->
                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="Start" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding StartPixel, UpdateSourceTrigger=PropertyChanged}" Width="44" TextAlignment="Center" Margin="0,0,8,0"/>
                                                                                <TextBlock Text="Stop" Foreground="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                                <TextBox Text="{Binding StopPixel, UpdateSourceTrigger=PropertyChanged}" Width="44" TextAlignment="Center" Margin="0,0,8,0"/>
                                                                            </StackPanel>

                                                                            <!-- Colour swatches: idle · primary · color2? · color3? -->
                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Idle colour" Tag="Idle" Click="SegmentColorPicker_Click" Margin="0,0,2,0">
                                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding IdleHexColor}" BorderBrush="#555" BorderThickness="1"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Primary colour" Tag="Primary" Click="SegmentColorPicker_Click" Margin="0,0,2,0">
                                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding HexColor}" BorderBrush="#555" BorderThickness="1"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Colour 2" Tag="Color2" Click="SegmentColorPicker_Click" Margin="0,0,2,0"
                                                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag.NeedsSecondaryColor, Converter={StaticResource BoolToVis}}">
                                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding HexColor2}" BorderBrush="#555" BorderThickness="1"/>
                                                                                </Button>
                                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26" ToolTip="Colour 3" Tag="Color3" Click="SegmentColorPicker_Click"
                                                                                        Visibility="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag.NeedsThirdColor, Converter={StaticResource BoolToVis}}">
                                                                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding HexColor3}" BorderBrush="#555" BorderThickness="1"/>
                                                                                </Button>
                                                                            </StackPanel>

                                                                            <!-- Delete -->
                                                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Remove segment"
                                                                                    Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext}"
                                                                                    Click="RemoveSegment_Click">
                                                                                <Viewbox Width="13" Height="13">
                                                                                    <Canvas Width="24" Height="24">
                                                                                        <Path Data="{StaticResource DeleteIcon}" Fill="#CF6679"/>
                                                                                    </Canvas>
                                                                                </Viewbox>
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Margin="24,0,0,0" Opacity="{Binding UsePreset, Converter={StaticResource BoolToOpacity}, ConverterParameter=Invert}">
                                                        <TextBlock Text="Animation" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                                                        <ComboBox SelectedIndex="{Binding AnimationTypeInt}" Margin="0,0,0,12">
                                                            <ComboBoxItem Content="Solid"/>
                                                            <ComboBoxItem Content="Flash"/>
                                                            <ComboBoxItem Content="Alternate Colors"/>
                                                            <ComboBoxItem Content="Bar Fill"/>
                                                            <ComboBoxItem Content="RPM"/>
                                                            <ComboBoxItem Content="Chase"/>
                                                        </ComboBox>
                                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsFlashAnimation, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Flash Speed (ms)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding FlashSpeedMs}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,8" Visibility="{Binding IsAlternateAnimation, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Alternate Speed (ms)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding AlternateSpeedMs}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel Visibility="{Binding IsValueAnimation, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                                            <TextBlock Text="Value Property" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                            <TextBox Text="{Binding ValueFormula}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8" TextChanged="FormulaBox_TextChanged" PreviewKeyDown="FormulaBox_PreviewKeyDown" LostFocus="FormulaBox_LostFocus"/>
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Min Value" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ValueMin}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                            </Grid>
                                                            <Grid>
                                                                <TextBlock Text="Max Value" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding ValueMax}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <Grid Margin="0,0,0,4" Visibility="{Binding IsChaseAnimation, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Window Size (LEDs)" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{Binding ChaseWindowSize}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                        </Grid>
                                                        <StackPanel Visibility="{Binding IsRpmSweepAnimation, Converter={StaticResource BoolToVis}}">
                                                            <Grid Margin="0,0,0,4">
                                                                <TextBlock Text="Zone 2 Start %" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding RpmZone2Start}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                            </Grid>
                                                            <Grid>
                                                                <TextBlock Text="Zone 3 Start %" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                                                <TextBox Text="{Binding RpmZone3Start}" Width="60" HorizontalAlignment="Right" TextAlignment="Center"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <local:LedStripPreview
                                                    Height="8" Margin="0,16,0,0"
                                                    Visibility="{Binding UsePreset, Converter={StaticResource InvertBoolToVis}}"
                                                    TotalLedCount="{Binding DataContext.SelectedDevice.TotalLedCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Segments="{Binding Segments}"
                                                    IdleColor="#1A1A1A"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Snackbar: slides up from bottom on action feedback -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#323232" CornerRadius="4" Padding="16,10" Margin="0,0,0,24"
                Panel.ZIndex="100" Opacity="0" MinWidth="280">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SnackbarTranslate"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SnackbarText" Grid.Column="0" Foreground="#F3F3F3" FontSize="13" VerticalAlignment="Center"/>
                <Button x:Name="SnackbarUndoBtn" Grid.Column="1" Content="UNDO"
                        Foreground="{StaticResource AccentColor}" Background="Transparent" BorderThickness="0"
                        FontWeight="Bold" FontSize="12" Padding="16,0,0,0" Cursor="Hand"
                        Visibility="Collapsed" Click="SnackbarUndo_Click"/>
            </Grid>
        </Border>

        <Popup x:Name="PropertyPopup" Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
            <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="0,0,4,4" MaxHeight="200">
                <ListBox x:Name="PropertySuggestionList" Background="Transparent" BorderThickness="0" Focusable="False" PreviewMouseLeftButtonDown="PropertySuggestionList_MouseDown" MinWidth="300">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#F3F3F3"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#333"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#331DD383"/>
                                                <Setter Property="Foreground" Value="#1DD383"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
